"""{{ project.name|replace('"', '\\"') }} - Auth schemas"""

{% set user_fields = project.security_config.user_fields %}
{% set self_service_fields = user_fields|selectattr('self_service')|list %}
{% macro user_field(f, mode) -%}
{%- set base = py_type(f) -%}
{%- set annotation = ('Optional[' ~ base ~ ']') if (f.nullable or mode == 'update') else base -%}
{%- set has_default = f.default is not none -%}
{%- if mode == 'update' -%}{%- set default = 'None' -%}
{%- elif mode == 'response' -%}{%- set default = 'None' if f.nullable else none -%}
{%- else -%}{%- set default = py_default(f) if has_default else ('None' if f.nullable else '...') -%}{%- endif -%}
{%- set options = (['max_length=' ~ f.max_length] if (mode != 'response' and f.type == 'string' and f.max_length) else []) + (['description=' ~ (f.description|python_value)] if f.description else []) -%}
{{ '    ' }}{{ f.name }}: {{ annotation }}{% if options %} = Field({{ default if default is not none else '...' }}, {{ options|join(', ') }}){% elif default is not none %} = {{ default }}{% endif %}
{%- endmacro %}
{% if user_fields %}
{% set type_imports = schema_type_imports(user_fields) %}
from typing import Any, List, Optional
from datetime import date, datetime
{% if type_imports.decimal %}
from decimal import Decimal
{% endif %}
{% if type_imports.uuid %}
from uuid import UUID
{% endif %}
from pydantic import BaseModel, EmailStr, Field
{% if type_imports.enums %}
from database.enums import {{ type_imports.enums|join(', ') }}
{% endif %}
{% else %}
from typing import List
from pydantic import BaseModel, EmailStr, Field
{% endif %}


class UserRegister(BaseModel):
    email: EmailStr
    password: str = Field(..., min_length=8)
