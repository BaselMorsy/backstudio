{{ user_field(f, 'create') }}
{% endfor %}


class AcceptInviteRequest(BaseModel):
    token: str
    new_password: str = Field(..., min_length=8)


class ResendInviteRequest(BaseModel):
    email: EmailStr


class ResendInviteResponse(BaseModel):
    message: str
    webhook_delivered: bool


