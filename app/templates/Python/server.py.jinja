"""{{ project.name|replace('"', '\\"') }} - Main server application"""

from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from database.base import {% if project.database_config.async_mode %}engine, {% endif %}init_db
{% if project.middlewares %}
from middleware import {% for mw in project.middlewares %}{{ mw.name|snake_case }}{{ ", " if not loop.last else "" }}{% endfor %}
{% endif %}
{% if project.modules %}
{% for module in project.modules %}
from modules.{{ module.snake_name }}.routes import router as {{ module.snake_name }}_router
{% endfor %}
{% endif %}
{% if project.auth_enabled %}
from modules.{{ project.auth_module_name }}.routes import router as auth_router
{% endif %}

# Lifespan context manager for startup/shutdown events
@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup
    {{ 'await ' if project.database_config.async_mode }}init_db()
    yield
    # Shutdown
{% if project.database_config.async_mode %}
    await engine.dispose()
{% else %}
    pass
{% endif %}

# Initialize FastAPI app
app = FastAPI(
    title={{ project.name|tojson }},
    description={{ (project.description or 'Generated by BackStudio')|tojson }},
    version="{{ project.version }}",
    lifespan=lifespan,
)

# CORS Configuration
{% if project.security_config and project.security_config.allowed_origins %}
app.add_middleware(
    CORSMiddleware,
    allow_origins={{ project.security_config.allowed_origins|tojson }},
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)
{% else %}
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)
{% endif %}

# Add custom middlewares
{% if project.middlewares %}
{% for mw in project.middlewares %}
{% if mw.enabled %}
app.add_middleware({{ mw.name|pascal_case }})
{% endif %}
{% endfor %}
{% endif %}

# Include routers
{% if project.modules %}
{% for module in project.modules %}
app.include_router({{ module.snake_name }}_router)
{% endfor %}
{% endif %}
{% if project.auth_enabled %}
app.include_router(auth_router, prefix="/{{ project.auth_module_name }}", tags=["{{ project.auth_module_name }}"])
{% endif %}

@app.get("/")
async def root():
    """Root endpoint"""
    return {
        "name": {{ project.name|tojson }},
        "version": "{{ project.version }}",
        "status": "running",
        "checksum": "{{ project.checksum }}"
    }

@app.get("/health")
async def health_check():
    """Health check endpoint"""
    return {"status": "healthy"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
