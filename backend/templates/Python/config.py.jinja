"""{{ project.name }} - Configuration settings"""

import os
from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Application settings"""

    # Database
    DATABASE_URL: str = os.getenv(
        "DATABASE_URL",
        "sqlite:///./{{ project.name|snake_case }}.db"  # Default to SQLite for easy testing
    )

    {% if project.security_config and project.security_config.auth_strategy == 'jwt' %}
    # Security - JWT
    JWT_SECRET_KEY: str = os.getenv(
        "JWT_SECRET_KEY",
        "change-this-secret-key-in-production-use-a-long-random-string"
    )
    JWT_ALGORITHM: str = "{{ project.security_config.jwt_algorithm }}"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = {{ project.security_config.jwt_expiration_minutes }}
    {% endif %}

    # Application
    DEBUG: bool = os.getenv("DEBUG", "True").lower() == "true"
    APP_NAME: str = "{{ project.name }}"
    APP_VERSION: str = "{{ project.version }}"

    class Config:
        env_file = ".env"
        case_sensitive = True


# Create global settings instance
settings = Settings()
